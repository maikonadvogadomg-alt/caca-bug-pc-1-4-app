{
  "name": "caca-bug-pc",
  "version": "1.0.0",
  "description": "Caça-Bug para PC — acha defeitos, analisa, limpa e publica projetos, com o terminal do computador",
  "author": "Maikon",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "programa": "electron .",
    "exe": "electron-builder --win nsis portable --x64 --publish never"
  },
  "dependencies": {
    "ws": "^8.18.0",
    "msedge-tts": ">=1.3.4"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "com.maikon.cacabug.pc",
    "productName": "Caça-Bug",
    "executableName": "CacaBug",
    "directories": {
      "output": "release"
    },
    "files": [
      "app/**/*",
      "electron/**/*",
      "package.json"
    ],
    "asar": false,
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "app/icons/icon-512.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Caça-Bug",
      "artifactName": "CacaBug-Instalar.exe",
      "include": "electron/instalar.nsh"
    },
    "portable": {
      "artifactName": "CacaBug-sem-instalar.exe"
    }
  },
  "portaDoPrograma": 7710
}